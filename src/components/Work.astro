---
import { projects } from '../data/projects';
---

<!-- Floating hover card -->
<div class="work__hover-card" id="work-hover-card" aria-hidden="true">
  <div class="work__hover-accent" aria-hidden="true"></div>
  <div class="work__hover-inner" id="work-hover-inner">
    <div class="work__hover-header">
      <span class="work__hover-category" id="work-hover-category"></span>
      <span class="work__hover-year" id="work-hover-year"></span>
    </div>
    <p class="work__hover-desc" id="work-hover-desc"></p>
    <div class="work__hover-footer">
      <ul class="work__hover-tags" id="work-hover-tags"></ul>
      <span class="work__hover-cta" id="work-hover-cta"></span>
    </div>
  </div>
</div>

<section id="work" class="work">
  <div class="container-portfolio">
    <span class="section-label">Selected Work</span>

    <ul class="work__list">
      {projects.map((project, i) => (
        <li class="work__item">
          <a
            href={project.link ?? '#'}
            class="work__row"
            target={project.link ? '_blank' : undefined}
            rel={project.link ? 'noopener noreferrer' : undefined}
            data-has-link={project.link ? 'true' : 'false'}
            data-description={project.description}
            data-tags={project.tags.join(',')}
            data-category={project.category}
            data-year={project.year}
            data-link={project.link ?? ''}
          >
            {/* Sliding background fill */}
            <span class="work__fill" aria-hidden="true"></span>

            {/* Index number */}
            <span class="work__index">0{i + 1}</span>

            {/* Title + tags */}
            <div class="work__center">
              <span class="work__title">{project.title}</span>
              <span class="work__tags">
                {project.tags.join(' · ')}
              </span>
            </div>

            {/* Right meta */}
            <div class="work__right">
              <span class="work__category">{project.category}</span>
              <span class="work__year">{project.year}</span>
              {project.link && (
                <svg class="work__arrow" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="7" y1="17" x2="17" y2="7"/>
                  <polyline points="7 7 17 7 17 17"/>
                </svg>
              )}
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .work {
    padding-block: clamp(5rem, 10vw, 9rem);
    border-bottom: 1px solid var(--color-border);
  }

  /* List */
  .work__list {
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .work__item {
    border-bottom: 1px solid var(--color-border);
  }

  /* Row */
  .work__row {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: center;
    gap: 2rem;
    padding-block: 2rem;
    padding-inline: 0.5rem;
    text-decoration: none;
    color: var(--color-text);
    overflow: hidden;
    cursor: pointer;
    transition: color 0.4s ease;
  }

  /* Sliding fill — sweeps left to right on hover */
  .work__fill {
    position: absolute;
    inset: 0;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }

  .work__row:hover .work__fill {
    transform: scaleX(1);
  }

  /* Flip text to contrast on hover */
  .work__row:hover {
    color: var(--color-bg);
  }

  /* All direct children sit above the fill */
  .work__index,
  .work__center,
  .work__right {
    position: relative;
    z-index: 1;
  }

  /* Index */
  .work__index {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    transition: color 0.3s ease;
    align-self: start;
    padding-top: 0.35rem;
  }

  .work__row:hover .work__index {
    color: color-mix(in srgb, var(--color-bg) 70%, transparent);
  }

  /* Center — title + tags */
  .work__center {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .work__title {
    font-size: clamp(1.8rem, 4vw, 3.5rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.05;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: letter-spacing 0.4s ease;
  }

  .work__row:hover .work__title {
    letter-spacing: -0.01em;
  }

  .work__tags {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    transition: color 0.3s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .work__row:hover .work__tags {
    color: color-mix(in srgb, var(--color-bg) 75%, transparent);
  }

  /* Right meta */
  .work__right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
    text-align: right;
  }

  .work__category {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 0.3s ease;
  }

  .work__row:hover .work__category {
    color: color-mix(in srgb, var(--color-bg) 70%, transparent);
  }

  .work__year {
    font-size: 0.75rem;
    font-weight: 300;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    transition: color 0.3s ease;
  }

  .work__row:hover .work__year {
    color: color-mix(in srgb, var(--color-bg) 70%, transparent);
  }

  /* Arrow */
  .work__arrow {
    flex-shrink: 0;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.3s ease;
  }

  .work__row:hover .work__arrow {
    transform: translate(4px, -4px);
  }

  /* Mobile: collapse right meta, shrink grid */
  @media (max-width: 640px) {
    .work__row {
      grid-template-columns: 2rem 1fr;
      gap: 1rem;
      padding-block: 1.5rem;
    }

    .work__right {
      display: none;
    }

    .work__title {
      white-space: normal;
    }
  }

  @media (min-width: 641px) and (max-width: 900px) {
    .work__category {
      display: none;
    }
  }

  /* ── Hover card ── */
  .work__hover-card {
    position: fixed;
    z-index: 200;
    width: 300px;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.18);
    pointer-events: none;
    opacity: 0;
    transform: scale(0.94);
    transition:
      opacity 0.18s ease,
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: left, top, opacity, transform;
    display: none;
    overflow: hidden;
  }

  @media (hover: hover) and (pointer: fine) {
    .work__hover-card { display: block; }
  }

  .work__hover-card.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  /* Accent gradient bar at top */
  .work__hover-accent {
    height: 3px;
    background: linear-gradient(
      90deg,
      var(--color-accent),
      var(--color-highlight)
    );
  }

  .work__hover-inner {
    padding: 1.1rem 1.4rem 1.25rem;
    opacity: 1;
    transition: opacity 0.12s ease;
  }

  .work__hover-inner.is-switching {
    opacity: 0;
  }

  .work__hover-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .work__hover-category {
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .work__hover-year {
    font-size: 0.65rem;
    font-weight: 300;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .work__hover-desc {
    font-size: 0.8rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .work__hover-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .work__hover-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    flex: 1;
  }

  .work__hover-tags li {
    font-size: 0.58rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.18rem 0.45rem;
    border-radius: 2px;
    white-space: nowrap;
  }

  .work__hover-cta {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    white-space: nowrap;
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .work__hover-cta.is-shown {
    opacity: 1;
  }
</style>

<script>
  const card     = document.getElementById('work-hover-card')  as HTMLElement;
  const inner    = document.getElementById('work-hover-inner') as HTMLElement;
  const descEl   = document.getElementById('work-hover-desc')  as HTMLElement;
  const tagsEl   = document.getElementById('work-hover-tags')  as HTMLElement;
  const catEl    = document.getElementById('work-hover-category') as HTMLElement;
  const yearEl   = document.getElementById('work-hover-year')  as HTMLElement;
  const ctaEl    = document.getElementById('work-hover-cta')   as HTMLElement;
  const rows     = document.querySelectorAll<HTMLElement>('.work__row');

  if (card && inner && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {

  const OFFSET = 28;
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  let tx = 0, ty = 0, cx = 0, cy = 0;
  let mouseEX = 0, mouseEY = 0;
  let rafRunning = false;

  function computeTarget(ex: number, ey: number) {
    const w = card.offsetWidth;
    const h = card.offsetHeight;
    let x = ex + OFFSET;
    let y = ey + OFFSET;
    if (x + w > window.innerWidth  - 16) x = ex - w - OFFSET;
    if (y + h > window.innerHeight - 16) y = ey - h - OFFSET;
    return { x, y };
  }

  document.addEventListener('mousemove', (e) => {
    mouseEX = e.clientX;
    mouseEY = e.clientY;
    const t = computeTarget(mouseEX, mouseEY);
    tx = t.x;
    ty = t.y;
  }, { passive: true });

  function tick() {
    cx = lerp(cx, tx, 0.14);
    cy = lerp(cy, ty, 0.14);
    card.style.left = `${cx}px`;
    card.style.top  = `${cy}px`;
    if (rafRunning) requestAnimationFrame(tick);
  }

  function populate(row: HTMLElement) {
    catEl.textContent  = row.dataset.category ?? '';
    yearEl.textContent = row.dataset.year     ?? '';
    descEl.textContent = row.dataset.description ?? '';
    const tags = (row.dataset.tags ?? '').split(',').filter(Boolean);
    tagsEl.innerHTML   = tags.map(t => `<li>${t}</li>`).join('');
    const hasLink = row.dataset.link;
    ctaEl.textContent  = hasLink ? 'Open ↗' : '';
    ctaEl.classList.toggle('is-shown', !!hasLink);
  }

  rows.forEach((row) => {
    row.addEventListener('mouseenter', () => {
      const alreadyVisible = card.classList.contains('is-visible');

      // Snap position so card doesn't slide in from a stale spot
      const t = computeTarget(mouseEX, mouseEY);
      cx = t.x; cy = t.y; tx = t.x; ty = t.y;
      card.style.left = `${cx}px`;
      card.style.top  = `${cy}px`;

      if (alreadyVisible) {
        inner.classList.add('is-switching');
        setTimeout(() => { populate(row); inner.classList.remove('is-switching'); }, 100);
      } else {
        populate(row);
      }

      card.classList.add('is-visible');
      if (!rafRunning) { rafRunning = true; requestAnimationFrame(tick); }
    });

    row.addEventListener('mouseleave', () => {
      card.classList.remove('is-visible');
      rafRunning = false;
    });
  });

  } // end hover guard
</script>
