---
---

<section id="about" class="about">
  <div class="container-portfolio">
    <span class="section-label">About</span>

    <div class="about__grid">
      <div class="about__portrait">
        <div class="about__portrait-inner">
          <!-- Placeholder silhouette — replace src with a real photo -->
          <svg viewBox="0 0 200 220" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="100" cy="72" r="42" fill="currentColor" opacity="0.18"/>
            <path d="M20 220 C20 160 180 160 180 220" fill="currentColor" opacity="0.18"/>
          </svg>
        </div>
      </div>

      <div class="about__text">
        <h2 class="about__heading">A little about me.</h2>
        <p class="about__bio">
          I'm Viju Sanjai, a B.Tech student in Electronics and Communication at VIT Chennai,
          building at the intersection of systems programming and full-stack development.
          I care about writing software that's fast, correct, and deliberately crafted —
          whether that's a GPU video pipeline or a browser-native PDF editor.
        </p>
        <p class="about__bio">
          Previously a software development intern at Lagoon Technologies, where I worked
          on enterprise tooling in C# and .NET. Outside of work I research quantum-chaotic
          steganography, mentor students on Git and open-source practices, and dig into
          low-level challenges through CTFs.
        </p>

        <ul class="about__tags">
          <li>Rust</li>
          <li>TypeScript</li>
          <li>React</li>
          <li>C/C++</li>
          <li>Python</li>
          <li>Go</li>
          <li>WebGPU</li>
          <li>Tauri</li>
          <li>Cloudflare</li>
          <li>Docker</li>
          <li>AWS</li>
          <li>Linux</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(5rem, 10vw, 9rem);
    border-bottom: 1px solid var(--color-border);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .about__grid {
      grid-template-columns: 300px 1fr;
      gap: 5rem;
      align-items: start;
    }
  }

  /* Portrait */
  .about__portrait {
    width: 100%;
    max-width: 300px;
  }

  .about__portrait-inner {
    width: 100%;
    aspect-ratio: 1;
    background-color: var(--color-surface);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--color-text);
    transition: background-color 0.35s ease;
  }

  .about__portrait-inner svg {
    width: 60%;
    height: auto;
  }

  /* Text */
  .about__heading {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .about__bio {
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.8;
    color: var(--color-text);
    opacity: 0.85;
    margin-bottom: 1rem;
    max-width: 54ch;
  }

  .about__bio:last-of-type {
    margin-bottom: 2rem;
  }

  /* Tags */
  .about__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .about__tags li {
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.3rem 0.75rem;
    border-radius: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .about__tags li:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
