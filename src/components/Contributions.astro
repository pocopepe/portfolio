---
const API_URL = 'https://portfolio-api.avijusanjai.workers.dev/contributions';
---

<section id="contributions" class="contrib">
  <div class="container-portfolio">
    <div class="contrib__header">
      <span class="section-label">Open Source</span>
      <div class="contrib__counts" id="contrib-counts" aria-live="polite">
        <span class="contrib__count">
          <span class="contrib__count-num" id="merged-count">—</span>
          <span class="contrib__count-label">Merged</span>
        </span>
        <span class="contrib__count-sep" aria-hidden="true">/</span>
        <span class="contrib__count">
          <span class="contrib__count-num" id="open-count">—</span>
          <span class="contrib__count-label">Open</span>
        </span>
      </div>
    </div>

    <div class="contrib__scroll-wrap">
      <ul class="contrib__list" id="contrib-list" role="list" aria-live="polite">
      <!-- Skeleton rows -->
      {Array.from({ length: 6 }).map(() => (
        <li class="contrib__row contrib__row--skeleton">
          <div class="contrib__link contrib__link--skeleton">
            <span class="skel skel--num"></span>
            <span class="skel skel--repo"></span>
            <span class="skel skel--title"></span>
            <span class="skel skel--badge"></span>
            <span class="skel skel--date"></span>
          </div>
        </li>
      ))}
      </ul>
    </div>
  </div>
</section>

<script define:vars={{ API_URL }}>
  interface Contribution {
    repo: string;
    number: number;
    title: string;
    state: 'merged' | 'open' | 'closed';
    date: string;
    url: string;
  }

  function renderRow(c: Contribution): string {
    return `
      <li class="contrib__row">
        <a
          class="contrib__link"
          href="${c.url}"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="${c.repo} pull request ${c.number}: ${c.title}"
        >
          <span class="contrib__num">#${c.number}</span>
          <span class="contrib__repo">${c.repo}</span>
          <span class="contrib__title">${c.title}</span>
          <span class="contrib__state contrib__state--${c.state}">${c.state}</span>
          <span class="contrib__date">${c.date}</span>
          <span class="contrib__arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    `;
  }

  async function load() {
    const list = document.getElementById('contrib-list');
    const mergedEl = document.getElementById('merged-count');
    const openEl = document.getElementById('open-count');
    if (!list || !mergedEl || !openEl) return;

    try {
      const res = await fetch(API_URL);
      if (!res.ok) throw new Error(`${res.status}`);
      const contributions: Contribution[] = await res.json();

      mergedEl.textContent = String(contributions.filter((c) => c.state === 'merged').length);
      openEl.textContent = String(contributions.filter((c) => c.state === 'open').length);
      list.innerHTML = contributions.map(renderRow).join('');
    } catch {
      list.innerHTML = `
        <li class="contrib__error">
          Could not load contributions — <a href="https://github.com/pocopepe" target="_blank" rel="noopener noreferrer">view on GitHub ↗</a>
        </li>
      `;
    }
  }

  load();

  const list = document.getElementById('contrib-list');
  const wrap = list?.parentElement;
  list?.addEventListener('scroll', () => {
    if (!list || !wrap) return;
    const atEnd = list.scrollHeight - list.scrollTop <= list.clientHeight + 4;
    wrap.classList.toggle('is-scrolled-to-end', atEnd);
  }, { passive: true });
</script>

<style>
  .contrib {
    padding-block: clamp(5rem, 10vw, 9rem);
    border-bottom: 1px solid var(--color-border);
  }

  .contrib__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
    gap: 1rem;
  }

  .contrib__counts {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .contrib__count {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .contrib__count-num {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-text);
  }

  .contrib__count-label {
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
    opacity: 0.7;
  }

  .contrib__count-sep {
    color: var(--color-border);
    font-weight: 200;
  }

  .contrib__scroll-wrap {
    position: relative;
  }

  .contrib__scroll-wrap::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to bottom, transparent, var(--color-bg));
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  .contrib__scroll-wrap.is-scrolled-to-end::after {
    opacity: 0;
  }

  .contrib__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-border);
    max-height: 420px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .contrib__list::-webkit-scrollbar {
    width: 3px;
  }

  .contrib__list::-webkit-scrollbar-track {
    background: transparent;
  }

  .contrib__list::-webkit-scrollbar-thumb {
    background-color: var(--color-border);
    border-radius: 999px;
  }

  .contrib__row {
    border-bottom: 1px solid var(--color-border);
  }

  .contrib__link {
    display: grid;
    grid-template-columns: 72px 180px 1fr auto auto 20px;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.25rem;
    color: var(--color-text);
    text-decoration: none;
    position: relative;
    transition: padding-left 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contrib__link::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, var(--color-accent) 4%, transparent);
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: -1;
  }

  .contrib__link:hover::before,
  .contrib__link:focus-visible::before {
    opacity: 1;
  }

  .contrib__link:hover,
  .contrib__link:focus-visible {
    padding-left: 0.75rem;
  }

  .contrib__link:focus-visible {
    outline: none;
  }

  .contrib__num {
    font-size: 0.75rem;
    font-weight: 300;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .contrib__repo {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: -0.005em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.25s ease;
  }

  .contrib__link:hover .contrib__repo {
    color: var(--color-text);
  }

  .contrib__title {
    font-size: 0.88rem;
    font-weight: 300;
    color: var(--color-text);
    opacity: 0.85;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contrib__state {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
  }

  .contrib__state--merged {
    color: #a855f7;
    border-color: color-mix(in srgb, #a855f7 40%, var(--color-border));
    background-color: color-mix(in srgb, #a855f7 6%, transparent);
  }

  .contrib__state--open {
    color: #22c55e;
    border-color: color-mix(in srgb, #22c55e 40%, var(--color-border));
    background-color: color-mix(in srgb, #22c55e 6%, transparent);
  }

  .contrib__date {
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--color-muted);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .contrib__arrow {
    font-size: 0.9rem;
    color: var(--color-muted);
    opacity: 0;
    transform: translate(-4px, 4px);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contrib__link:hover .contrib__arrow,
  .contrib__link:focus-visible .contrib__arrow {
    opacity: 1;
    transform: translate(0, 0);
    color: var(--color-accent);
  }

  /* Error state */
  .contrib__error {
    padding-block: 1.5rem;
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-border);
  }

  .contrib__error a {
    color: var(--color-accent);
  }

  /* Skeleton */
  .skel {
    display: block;
    background: linear-gradient(
      90deg,
      var(--color-border) 25%,
      color-mix(in srgb, var(--color-border) 60%, transparent) 50%,
      var(--color-border) 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.4s ease infinite;
    border-radius: 3px;
    height: 10px;
  }

  .skel--num  { width: 40px; }
  .skel--repo { width: 120px; }
  .skel--title { width: 60%; }
  .skel--badge { width: 52px; height: 20px; border-radius: 999px; }
  .skel--date { width: 52px; }

  .contrib__link--skeleton {
    pointer-events: none;
  }

  @keyframes shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  /* Tablet */
  @media (max-width: 900px) {
    .contrib__link {
      grid-template-columns: 56px 1fr auto;
      grid-template-rows: auto auto;
      gap: 0.35rem 1rem;
      padding-block: 1.1rem;
    }

    .contrib__num {
      grid-row: 1 / 3;
      align-self: start;
      padding-top: 0.15rem;
    }

    .contrib__repo {
      grid-column: 2;
      grid-row: 1;
    }

    .contrib__title {
      grid-column: 2 / 4;
      grid-row: 2;
      white-space: normal;
      line-height: 1.45;
    }

    .contrib__state {
      grid-column: 3;
      grid-row: 1;
      justify-self: end;
    }

    .contrib__date,
    .contrib__arrow {
      display: none;
    }

    .skel--date,
    .skel--num ~ .skel--num {
      display: none;
    }
  }

  /* Mobile */
  @media (max-width: 500px) {
    .contrib__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .contrib__link {
      grid-template-columns: 1fr auto;
      gap: 0.3rem 0.75rem;
    }

    .contrib__num {
      grid-row: 1;
      grid-column: 1;
      padding-top: 0;
    }

    .contrib__repo {
      grid-column: 1;
      grid-row: 2;
    }

    .contrib__title {
      grid-column: 1 / 3;
      grid-row: 3;
    }

    .contrib__state {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
    }
  }
</style>
